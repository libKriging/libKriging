# CMake package of an installed libKriging:
#   find_package(libKriging CONFIG REQUIRED)   # CMAKE_PREFIX_PATH=<prefix>
#   target_link_libraries(app PRIVATE libKriging::Kriging)
# It resolves the dependencies referenced by the exported target (armadillo,
# lbfgsb_cpp, OpenMP and, for a static GPU build, the CUDA/HIP runtime) and
# propagates the Armadillo configuration libKriging was compiled with.
@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if (NOT TARGET armadillo)
    include("@PACKAGE_LIBKRIGING_ARMADILLO_CMAKE_DIR@/ArmadilloLibraryDepends.cmake")
endif ()
if (NOT TARGET lbfgsb_cpp::lbfgsb_cpp)
    find_dependency(lbfgsb_cpp CONFIG HINTS "${PACKAGE_PREFIX_DIR}/lib/cmake/lbfgsb_cpp")
endif ()
if (@LIBKRIGING_CONFIG_NEEDS_OPENMP@)
    find_dependency(OpenMP)
endif ()
if (@LIBKRIGING_CONFIG_NEEDS_CUDATOOLKIT@)
    find_dependency(CUDAToolkit)
endif ()
if (@LIBKRIGING_CONFIG_NEEDS_HIP@)
    find_dependency(hip)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/../libKriging.cmake")

check_required_components(libKriging)
