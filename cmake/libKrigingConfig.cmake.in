@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Public dependencies of the Kriging target
# Armadillo's own ArmadilloConfig.cmake contains absolute paths (not relocatable): when Armadillo is installed
# together with libKriging, import its (relocatable) export file directly
if (NOT TARGET armadillo)
    include("${PACKAGE_PREFIX_DIR}/share/Armadillo/CMake/ArmadilloLibraryDepends.cmake" OPTIONAL)
endif ()
if (NOT TARGET armadillo)
    find_dependency(Armadillo CONFIG)
endif ()
find_dependency(lbfgsb_cpp)
if (@OpenMP_CXX_FOUND@)
    find_dependency(OpenMP COMPONENTS CXX)
endif ()

include("${CMAKE_CURRENT_LIST_DIR}/libKrigingTargets.cmake")

check_required_components(libKriging)
